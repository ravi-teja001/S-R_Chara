{
  "name": "biochar-api",
  "version": "1.0.0",
  "description": "Biochar Management API - Railway backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('database/schema.sql', 'dist/schema.sql')\"",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "deploy": "railway up --detach",
    "db:schema": "railway run node scripts/run-schema.js",
    "db:schema:local": "node scripts/run-schema.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0"
  }
}
